rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Health / connection test probe
    match /test/{id} {
      allow read: if true;
    }

    // User-owned document isolation
    match /users/{userId}/documents/{documentId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(documentId);
      allow update: if isOwner(userId) && isValidId(documentId);
      allow delete: if isOwner(userId) && isValidId(documentId);
    }
  }
}
